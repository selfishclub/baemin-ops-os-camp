# 이 파일을 복사해 .env.local 로 만들고 = 뒤에 값을 붙여넣습니다. .env.local 은 GitHub에 올라가지 않습니다.
# Supabase 대시보드 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 절대 여기에도, 어디에도 적지 않습니다.

# --- 유출 방지 (비공개 버전) ---
# 한동안 쓰지 않으면 자동 로그아웃 (분). 비우면 30, 0 이면 끄기
AUTO_LOGOUT_MINUTES=30
# 매장 인터넷 주소 (쉼표로 여러 개). 열람 기록 화면의 "지금 이 화면을 보는 곳"에서 확인. 끝이 점(.)이면 앞부분만 비교
SHOP_IPS=
# 1 이면 매장 밖에서 온 직원 접속을 막는다 (사장은 어디서나). 비우면 기록에 "매장 밖"으로 표시만
BLOCK_OUTSIDE_STAFF=
# AI 챗봇 열쇠 (서버에만). 비우면 규칙 답변기만 동작
ANTHROPIC_API_KEY=
